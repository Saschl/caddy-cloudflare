{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["git-refs"],
      "matchFileNames": ["Dockerfile"],
      "groupName": "Caddy plugins",
      "groupSlug": "caddy-plugins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update xcaddy plugin commit pins from each repository's default branch",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "--with\\s+(?<depName>github\\.com/[^/\\s@]+/[^/\\s@]+)(?:/[^\\s@]+)?@(?<currentDigest>[a-f0-9]{40})(?:\\s|$)"
      ],
      "packageNameTemplate": "https://{{{depName}}}",
      "datasourceTemplate": "git-refs"
    }
  ]
}
