{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchFileNames": ["Dockerfile"],
      "ignoreUnstable": true,
      "groupName": "Caddy plugins",
      "groupSlug": "caddy-plugins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update xcaddy plugins from semantic version tags",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "--with\\s+github\\.com/(?<packageName>[^/\\s@]+/[^/\\s@]+)(?:/[^\\s@]+)?@(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:[-+][^\\s]+)?)(?:\\s|$)"
      ],
      "depNameTemplate": "github.com/{{{packageName}}}",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
